# Copie ce fichier en .env.local et remplis avec tes vraies valeurs
# (Supabase > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Assistant NEQ IA — cascade de secours, dans l'ordre de priorité.
# Renseigne-en au moins un pour que l'assistant réponde ; plus tu en
# configures, plus l'application reste disponible même si l'un tombe.

# 1. Ollama (auto-hébergé, gratuit et illimité si tu le fais tourner
#    toi-même — https://ollama.com). Laisse vide si tu ne l'utilises pas.
OLLAMA_API_URL=
OLLAMA_MODEL=llama3.1

# 2. DeepSeek (5M tokens offerts)
DEEPSEEK_API_KEY=

# 3. OpenAI (GPT-4o-mini)
OPENAI_API_KEY=

# 4. Google Gemini (Flash)
GOOGLE_GEMINI_API_KEY=

# 5. NVIDIA NIM
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct

# 6. OpenRouter (dernier recours, couvre de nombreux modèles)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clé service_role Supabase (Project Settings > API Keys > Legacy > service_role)
# Nécessaire uniquement pour le webhook de paiement, jamais exposée au client.
SUPABASE_SERVICE_ROLE_KEY=

# Paiement MoneyFusion — à remplir une fois le domaine réel confirmé
# auprès d'eux (voir note plus bas).
MONEYFUSION_API_KEY=
MONEYFUSION_API_URL=
